#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints the parsekit-bin version to build for the newest upstream parsekit
# version that is not fully published yet, or nothing when every expected
# platform gem is on rubygems.org.

require "json"
require "net/http"

EXPECTED_PLATFORMS = ["ruby", "x86_64-linux", "aarch64-linux", /\Aarm64-darwin/].freeze

# Upstream versions whose parsekit-bin gems were published broken, mapped to the
# fourth-segment version that rebuilds them.
REBUILDS = {"0.2.0" => "0.2.0.1"}.freeze

def versions(gem_name)
  JSON.parse(Net::HTTP.get(URI("https://rubygems.org/api/v1/versions/#{gem_name}.json")))
end

upstream = versions("parsekit").map { |v| Gem::Version.new(v["number"]) }.reject(&:prerelease?).max.to_s
target = REBUILDS.fetch(upstream, upstream)
published = versions("parsekit-bin").select { |v| v["number"] == target }.map { |v| v["platform"] }
missing = EXPECTED_PLATFORMS.reject { |expected| published.any? { |platform| expected === platform } }

if missing.empty?
  warn "parsekit-bin #{target} is complete"
else
  warn "parsekit-bin #{target} is missing #{missing.join(", ")}"
  puts target
end
