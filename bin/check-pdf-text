#!/usr/bin/env ruby
# frozen_string_literal: true

# Loads the installed parsekit-bin gem and checks it reads the text of a PDF that
# uses a standard font without embedding it, as most generated PDFs do.

require "parsekit"

expected = "Read with non-embedded Helvetica"
text = ParseKit.parse_file(ARGV.fetch(0) { abort "usage: bin/check-pdf-text <pdf>" }).strip
abort "parsekit-bin #{ParseKit::VERSION} read #{text.inspect}, expected #{expected.inspect}" unless text == expected

puts "parsekit-bin #{ParseKit::VERSION} on #{RUBY_PLATFORM} read #{text.inspect}"
